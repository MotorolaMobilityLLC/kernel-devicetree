&tlmm {
	sar_int_default: sar_int_default {
			mux {
				pins = "gpio67";
				function =  "gpio";
			};
			config {
				pins = "gpio67";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};
	sar_int_sleep: sar_int_sleep {
			mux {
				pins = "gpio67";
				function =  "gpio";
			};
			config {
				pins = "gpio67";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};
};

&qupv3_se5_i2c {
        status = "okay";
        sx937x@2c { /* SAR sensor */
		compatible = "Semtech,sx937x";
		reg = <0x2c>;
		Semtech,power-supply-type = <0>;
		cap_vdd-supply = <&L15B>;
		pinctrl-names = "default","sleep";
		pinctrl-0 = <&sar_int_default>;
		pinctrl-1 = <&sar_int_sleep>;
		interrupt-parent = <&tlmm>;
		interrupts = <67 0x02>;
		interrupt-names = "capsense0_irq";
		Semtech,nirq-gpio= <&tlmm 67 0x02>;
		reinit-on-i2c-failure = <1>;
		esd-reinit-on = <1>;
		/*use PH4/5/6 as the reference sensor
		set it to 0xff if the ref-phases-x is not used*/
		Semtech,ref-phases-a = <4>;
		Semtech,ref-phases-b = <5>;
		Semtech,ref-phases-c = <6>;
		Semtech,button-flag = <0x07>;
		Semtech,button-names = "Moto CapSense Ch0","Moto CapSense Ch1","Moto CapSense Ch2";
		Semtech,reg-num = <64>;
		Semtech,reg-init = <
			0x4004 0x00000074
			0x8020 0x00000032
			0x8028 0x0000085E
			0x8034 0x0000088E
			0x8040 0x0000085E
			0x804C 0x0000085E
			0x8058 0x0000085E
			0x8064 0x0000087F
			0x8070 0x0000087F
			0x807C 0x0000087F
			0x8030 0x00964964
			0x803C 0x0092492C
			0x8048 0x00925924
			0x8054 0x00B24924
			0x8060 0x0092C924
			0x806C 0x00FFFFFF
			0x8078 0x00FFFFFF
			0x8084 0x00FFFFFF
			0x8098 0x00006735
			0x80B8 0x00006E6E
			0x80D8 0x00005F2A
			0x80F8 0x000000FF
			0x8118 0x000000FF
			0x8138 0x000000FF
			0x8158 0x000000FF
			0x8178 0x000000FF
			0x80A0 0x75750001
			0x80C0 0x16160002
			0x80E0 0x18180002
			0x8188 0x08000013
			0x818C 0x08000014
			0x8090 0x788C5000
			0x80B0 0x788C5000
			0x80D0 0x788C5000
			0x80F0 0x00005000
			0x8110 0x00005000
			0x8130 0x54AC5000
			0x8150 0x54AC5000
			0x8170 0x54AC5000
			0x8088 0x00300000
			0x80A8 0x00300000
			0x80C8 0x00300000
			0x80E8 0x06300000
			0x8108 0x06300000
			0x8128 0x00000000
			0x8148 0x00000000
			0x8168 0x00000000
			0x808C 0x60200030
			0x80AC 0x60200030
			0x80CC 0x60200030
			0x80EC 0x60200030
			0x810C 0x60200030
			0x812C 0x00000000
			0x814C 0x00000000
			0x816C 0x00000000
			0x802C 0x019A4669
			0x8038 0x00B542D5
			0x8044 0x01104441
			0x8050 0x009A826A
			0x805C 0x00B182C6
			0x8068 0x00B1C2C7
			0x8074 0x00DA836A
			0x8080 0x009A826A
			0x8024 0x7F00
		>;
		status = "okay";
	};
        awinic_sar@12 {
                /* common node */
                compatible = "awinic,aw_sar";
                reg = < 0x12 >;
                aw_sar,regulator-power-supply = <1>;
                sar-num = < 0 >;
                interrupt-parent = < &tlmm >;
                interrupts = <67 0x02>;
                interrupt-names = "awinic_irq";
                irq-gpio = <&tlmm 67 0x02>;
                vcc0-supply = <&L15B>;
                channel_use_flag = <0x07>;
                monitor_esd_flag = <1>;
                aw_sar,use_plug_cail;
                aw_sar,update_fw;
                /* private node belongs to aw963xx */
                start-mode = < 1 >; // 0: start in rom  1: start in ram
                irq-mux = < 2 >; // set csx as irq pin. config this field when connect to aw96308/aw96310
                status = "okay";
        };


};

&tlmm {
	phone_case_int_default: phone_case_int_default {
			mux {
				pins = "gpio65";
				function =  "gpio";
			};
			config {
				pins = "gpio65";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};

	phone_case_int_sleep: phone_case_int_sleep {
			mux {
				pins = "gpio65";
				function =  "gpio";
			};
			config {
				pins = "gpio65";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};
};

&soc {
	hall_phone_case_detect {
		compatible = "hall,hall_phone_case_detect";
		pinctrl-names = "default","sleep";
		pinctrl-0 = <&phone_case_int_default>;
		pinctrl-1 = <&phone_case_int_sleep>;
		hall,factory-class-name = "hall";
		hall,input-dev-name = "phone_case_hall_sensor";
		hall_vdd-supply = <&L1B>;
		hall,nirq-gpio-num = <1>;
		hall,nirq-gpio_0 = <&tlmm 65 0x02>;
		hall,nirq-gpio-high-val_0 = <0>;
		hall,nirq-gpio-low-val_0 = <1>;
	};
};
