#include <dt-bindings/gpio/gpio.h>
//#include <dt-bindings/iio/qcom,spmi-adc5-gen4-pmk8850.h>

&qupv3_se19_i2c {
	status = "disabled";
};
&qupv3_se0_i2c {
	status = "disabled";
};
