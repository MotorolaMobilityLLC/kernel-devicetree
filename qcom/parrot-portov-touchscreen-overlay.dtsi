&tlmm {
	pmx_ts_active {
		ts_spi_active: ts_spi_active {
			mux {
				pins = "gpio131", "gpio65";
				function = "gpio";
			};

			config {
				pins = "gpio131", "gpio65";
				drive-strength = <8>;
				bias-pull-up;
			};
		};
	};

	pmx_ts_reset_suspend {
		ts_spi_reset_suspend: ts_spi_reset_suspend {
			mux {
				pins = "gpio131";
				function = "gpio";
			};

			config {
				pins = "gpio131";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};

	pmx_ts_int_suspend {
		ts_spi_int_suspend: ts_spi_int_suspend {
			mux {
				pins = "gpio65";
				function = "gpio";
			};

			config {
				pins = "gpio65";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};

	pmx_ts_release {
		ts_spi_release: ts_spi_release {
			mux {
				pins = "gpio131", "gpio65";
				function = "gpio";
			};

			config {
				pins = "gpio131", "gpio65";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};
};

&qupv3_se9_i2c {
	status = "disabled";
};

&qupv3_se9_spi {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "ok";
	goodix-berlin@0 {
		status = "disabled";
	};
	chipone_tddi@0 {
		compatible = "chipone-tddi";
		reg = <0x0>;
		spi-max-frequency = <9600000>;
		interrupt-parent = <&tlmm>;
		interrupts = <65 0x2002>;
		spi-cpha;
		spi-cpol;
		chipone,rst-gpio = <&tlmm 131 0x00>;
		chipone,irq-gpio = <&tlmm 65 0x2002>;
		chipone,x-res = <4320>;
		chipone,y-res = <9600>;
		chipone,def-build-id = <0x0101>;
		chipone,def-config-id = <0x0001>;
		status = "ok";
	};

};
