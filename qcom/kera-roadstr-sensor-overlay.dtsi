                          0x8118  0x5A5A
                          0x8138  0x5A40
                          0x8158  0x5A40
                          0x8178  0x5A40
                          0x80A0  0x20200001
                          0x80C0  0x10100002
                          0x80E0  0x707001A
                          0x8100  0x49490002
                          0x8188  0x8000004
                          0x818C  0x8000005
                          0x8190  0x8000006
                          0x8090  0x20005000
                          0x80B0  0x8005000
