&tlmm {
        sar_int_default: sar_int_default {
                        mux {
                                pins = "gpio30";
                                function =  "gpio";
                        };
                        config {
                                pins = "gpio30";
                                num-grp-pins = <1>;
                                drive-strength = <2>;
                                bias-pull-up;
                        };
        };
        sar_int_sleep: sar_int_sleep {
                        mux {
                                pins = "gpio30";
                                function =  "gpio";
                        };
                        config {
                                pins = "gpio30";
                                num-grp-pins = <1>;
                                drive-strength = <2>;
                                bias-pull-up;
                        };
        };

        phone_case_int_default: phone_case_int_default {
			mux {
				pins = "gpio31";
				function =  "gpio";
			};
			config {
				pins = "gpio31";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};

	phone_case_int_sleep: phone_case_int_sleep {
			mux {
				pins = "gpio31";
				function =  "gpio";
			};
			config {
				pins = "gpio31";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};
};


&soc {
	hall_phone_case_detect {
		compatible = "hall,hall_phone_case_detect";
		pinctrl-names = "default","sleep";
		pinctrl-0 = <&phone_case_int_default>;
		pinctrl-1 = <&phone_case_int_sleep>;
		hall,factory-class-name = "hall";
		hall,input-dev-name = "phone_case_hall_sensor";
		hall_vdd-supply = <&L2G>;
		hall,nirq-gpio-num = <1>;
		hall,nirq-gpio_0 = <&tlmm 31 0x02>;
		hall,nirq-gpio-high-val_0 = <0>;
		hall,nirq-gpio-low-val_0 = <1>;
	};
};

&qupv3_se2_i2c {
        status = "ok";
        sx937x:sx937x@2c {
                compatible = "Semtech,sx937x";
                reg = <0x2c>;
                Semtech,power-supply-type = <1>;
                //cap_vdd-supply = <&L7B>;
                pinctrl-names = "default","sleep";
                pinctrl-0 = <&sar_int_default>;
                pinctrl-1 = <&sar_int_sleep>;
                //interrupt-parent = <&tlmm>;
                //interrupts = <30 0x02>;
                //interrupt-names = "sx937x_irq";
                Semtech,nirq-gpio = <&tlmm 30 0x02>;
                //esd-reinit-on = <1>;
                /*use PH5/6 as the reference sensor
                set it to 0xff if the ref-phases-x is not used*/
                Semtech,ref-phases-a = <5>;
                Semtech,ref-phases-b = <6>;
                Semtech,ref-phases-c = <0xff>;
                Semtech,button-flag = <0xf>;
                Semtech,reg-num = <60>;
                Semtech,reg-init = <
                          0x8024  0x7F00
                          0x4004  0x70
                          0x4008  0x8
                          0x8020  0x32
                          0x8028  0xD5E
                          0x8034  0xD5E
                          0x8040  0xD5E
