&tlmm{
	cam_pmic_en_default: cam_pmic_en_default {
		mux {
		pins = "gpio125";
		function = "gpio";
		};

		config {
		pins = "gpio125";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
		};
	};
};

/*
 * Each QUP device that's a parent to PMIC must be listed as a critical device
 * to GCC.
 */
&gcc {
	qcom,critical-devices = <&qupv3_se2_i2c>;
};

&qupv3_se2_i2c {
	status = "ok";
	cam_pmic: et5904@28 {
		compatible = "etek,et5904";
		reg = <0x28>;

		pinctrl-names = "et5904_gpio_en0";
		pinctrl-0 = <&cam_pmic_en_default>;

		vin1-supply = <&S8B>;
		vin2-supply = <&BOB>;

		regulators {
			et5904_ldo1: et5904_ldo1 {
				regulator-name = "et5904_ldo1";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
			};

			et5904_ldo2: et5904_ldo2 {
				regulator-name = "et5904_ldo2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
			};

			et5904_ldo3: et5904_ldo3 {
				regulator-name = "et5904_ldo3";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <4300000>;
			};

			et5904_ldo4: et5904_ldo4 {
				regulator-name = "et5904_ldo4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <4300000>;
			};
		};
	};
};
