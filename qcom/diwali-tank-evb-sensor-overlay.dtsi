&tlmm {
	sar_int_default: sar_int_default {
			mux {
				pins = "gpio10";
				function =  "gpio";
			};
			config {
				pins = "gpio10";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};

	sar_int_sleep: sar_int_sleep {
			mux {
				pins = "gpio10";
				function =  "gpio";
			};
			config {
				pins = "gpio10";
				num-grp-pins = <1>;
				drive-strength = <2>;
				bias-pull-up;
			};
	};

};

&qupv3_se1_i2c {
	status = "ok";
	sx937x@2c { /* SAR sensor */
		compatible = "Semtech,sx937x";
		reg = <0x2c>;
		Semtech,power-supply-type = <0>;
		cap_vdd-supply = <&L18B>;
		//cap_vdd-supply = <&pm_humu_l18>;
		pinctrl-names = "default","sleep";
		pinctrl-0 = <&sar_int_default>;
		pinctrl-1 = <&sar_int_sleep>;
		interrupt-parent = <&tlmm>;
		interrupts = <10 0x02>;
		interrupt-names = "capsense0_irq";
		Semtech,nirq-gpio= <&tlmm 10 0x02>;
		/*use PH4/5/6 as the reference sensor
		set it to 0xff if the ref-phases-x is not used*/
		Semtech,ref-phases-a = <4>;
		Semtech,ref-phases-b = <5>;
		Semtech,ref-phases-c = <6>;
		Semtech,button-flag = <0x07>;
		Semtech,reg-num = <57>;
		Semtech,reg-init = <
		        0x8024 0x00007F00
	                0x4004 0x00000070
	                0x4008 0x00000008
	                0x8020 0x00000032
	                0x8028 0x0000085E
	                0x8034 0x0000086E
	                0x8040 0x0000086E
	                0x804C 0x0000086E
	                0x8058 0x0000086E
	                0x8064 0x0000086E
	                0x8070 0x0000086E
	                0x807C 0x0000085E
	                0x8030 0x00924925
	                0x803C 0x0092C924
	                0x8048 0x00964924
	                0x8054 0x00924924
	                0x8060 0x00924924
	                0x806C 0x0092492C
	                0x8078 0x00924964
	                0x8084 0x00FFF9FF
	                0x8098 0x0000AA43
	                0x80B8 0x0000873C
	                0x80D8 0x00008383
	                0x80F8 0x00003232
	                0x8118 0x00002A2A
	                0x8138 0x00005A40
	                0x8158 0x00005A40
	                0x8178 0x00005A40
	                0x80A0 0x27270001
	                0x80C0 0x08080001
	                0x80E0 0x0C0C0001
	                0x8188 0x08000005
	                0x818C 0x00000006
	                0x8090 0x1A005000
	                0x80B0 0x1A005000
	                0x80D0 0x10005000
	                0x80F0 0x18005000
	                0x8110 0x18005000
	                0x8130 0x54AC5000
	                0x8150 0x54AC5000
	                0x8170 0x54AC5000
	                0x8088 0x00300000
	                0x80A8 0x00300000
	                0x80C8 0x00300000
	                0x80E8 0x00300000
	                0x8108 0x00300000
	                0x8128 0x00300000
	                0x8148 0x00300000
	                0x8168 0x00300000
	                0x808C 0x60200030
	                0x80AC 0x60200030
	                0x80CC 0x60200030
	                0x80EC 0x60200030
	                0x810C 0x60200030
	                0x812C 0x60200030
	                0x814C 0x60200030
	                0x816C 0x60200030
		>;
		status = "ok";
	};
	awinic_sar@12 {
		/* common node */
		compatible = "awinic,aw_sar";
		reg = < 0x12 >;
		aw_sar,regulator-power-supply = <1>;
		sar-num = < 0 >;
		interrupt-parent = < &tlmm >;
		interrupts = <10 0x02>;
		interrupt-names = "awinic_irq";
		irq-gpio = <&tlmm 10 0x02>;
		vcc0-supply = <&L18B>;
		channel_use_flag = <0x07>;
		aw_sar,use_plug_cail;
		aw_sar,update_fw;
		/* private node belongs to aw963xx */
		start-mode = < 1 >; // 0: start in rom  1: start in ram
		irq-mux = < 2 >; // set csx as irq pin. config this field when connect to aw96308/aw96310
		monitor_esd_flag = < 1 >; // enable esd recover timer
		status = "okay";
	};
};
